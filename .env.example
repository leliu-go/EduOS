# PostgreSQL connection string used by Prisma.
# Example only; configure a real value in .env.
DATABASE_URL="postgresql://eduos:eduos_password@localhost:55432/eduos_dev?schema=public"

# Used to sign EduOS session cookies. Use a long random value in real environments.
AUTH_SECRET="replace-with-a-long-random-session-secret"

# Used to sign student check-in QR tokens. If omitted, AUTH_SECRET is used.
CHECK_IN_QR_SECRET="replace-with-a-long-random-qr-secret"

# Public app URL used when generating QR check-in links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional local/demo seed password. Do not use this in production.
EDUOS_DEMO_PASSWORD="EduOS-demo-123456"

# Resource file storage provider. Use local for development.
# Production cloud providers require human-provisioned credentials and must not be committed.
RESOURCE_STORAGE_PROVIDER="local"
RESOURCE_STORAGE_LOCAL_ROOT=".local/resource-storage"
RESOURCE_STORAGE_LOCAL_BUCKET="local-resource-storage"
ALIYUN_OSS_ACCESS_KEY_ID=""
ALIYUN_OSS_ACCESS_KEY_SECRET=""
ALIYUN_OSS_BUCKET=""
ALIYUN_OSS_ENDPOINT=""
ALIYUN_OSS_REGION=""
ALIYUN_OSS_SIGNED_URL_TTL_SECONDS="300"

# MFA/TOTP placeholders. Production values require human provisioning and approval.
MFA_TOTP_ISSUER="EduOS"
MFA_ENCRYPTION_KEY_ID=""
MFA_TOTP_SECRET_ENCRYPTION_KEY=""
MFA_BACKUP_CODE_PEPPER=""
MFA_TOTP_WINDOW_SECONDS="30"
MFA_TOTP_MAX_ATTEMPTS="5"
