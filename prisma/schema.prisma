generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CampusStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MfaCredentialStatus {
  PENDING_VERIFICATION
  VERIFIED
  LOCKED
  DISABLED
}

enum AdminBackupDeviceRole {
  LOGIN_ONLY
  BACKUP_AUTHORIZED
  PRIMARY_BACKUP
  STANDBY_BACKUP
}

enum AdminBackupDeviceStatus {
  ACTIVE
  REVOKED
  LOST
  REPLACED
}

enum ActivityType {
  WORD_CHECKIN
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ENDED
}

enum ActivityAssignmentTargetType {
  CAMPUS
  CLASS_GROUP
  STUDENT
}

enum RoleKey {
  SUPER_ADMIN
  ORG_ADMIN
  CAMPUS_ADMIN
  ACADEMIC
  FINANCE
  TEACHER
  STUDENT
  PARENT
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  PAUSED
  GRADUATED
  WITHDRAWN
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  RELATIVE
  OTHER
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
}

enum ConfigStatus {
  ACTIVE
  INACTIVE
}

enum CourseType {
  ONE_ON_ONE
  SMALL_GROUP
  LARGE_GROUP
  EVENING_TUTORING
  INTENSIVE
}

enum ClassType {
  OFFLINE
  ONLINE
  HYBRID
}

enum CourseProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ClassGroupStatus {
  PLANNING
  ACTIVE
  PAUSED
  FINISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  WITHDRAWN
}

enum CourseAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LessonStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ScheduleStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
  MAKE_UP
}

enum ScheduleChangeType {
  CREATE
  RESCHEDULE
  CANCEL
  MAKE_UP
}

enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED
  ABSENT
  MAKE_UP
}

enum ResourceType {
  PPT
  HANDOUT
  VIDEO
  AUDIO
  WORKSHEET
  ANSWER
  EXPLANATION
}

enum ResourceStatus {
  ACTIVE
  ARCHIVED
}

enum ResourcePermissionTarget {
  CLASS_GROUP
  STUDENT
  ROLE
}

enum ResourceVisibility {
  PRIVATE
  TENANT_PUBLIC
}

enum HomeworkStatus {
  DRAFT
  ASSIGNED
  ARCHIVED
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  PENDING_CORRECTION
  CORRECTED
  NEEDS_REVISION
}

enum HomeworkCorrectionStatus {
  CORRECTED
  NEEDS_REVISION
}

enum LearningTaskType {
  READING
  MEMORIZATION
  PRACTICE
  SPECIAL_TRAINING
}

enum LearningTaskStatus {
  ACTIVE
  ARCHIVED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_BLANK
  SHORT_ANSWER
  ESSAY
}

enum ErrorRecordSourceType {
  HOMEWORK_SUBMISSION
  ASSESSMENT_RESULT
  MANUAL
}

enum ErrorReason {
  CONCEPT_UNCLEAR
  CALCULATION_ERROR
  READING_ERROR
  METHOD_ERROR
  CARELESS
  OTHER
}

enum ErrorRecordStatus {
  PENDING_CORRECTION
  CORRECTED
  MASTERED
}

enum NotificationEventType {
  SCHEDULE_CREATED
  SCHEDULE_CHANGED
  ATTENDANCE_CONFIRMED
  COURSE_CONSUMPTION_CREATED
  HOMEWORK_ASSIGNED
  HOMEWORK_CORRECTED
  REPORT_AVAILABLE
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  WECHAT
  ALIPAY
  CARD
  OTHER
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum ContractTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  CANCELLED
  EXPIRED
}

enum TeacherCompensationCalculationMode {
  LESSON
  HOUR
  STUDENT_COUNT
  CLASS_TYPE
}

enum TeacherCompensationRuleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ComplianceRuleType {
  FORBIDDEN_SCHEDULING_WINDOW
  MAX_PREPAID_HOURS
  CONTRACT_REQUIRED
  TEACHER_QUALIFICATION_REQUIRED
}

enum ComplianceRuleSeverity {
  WARN
  BLOCK
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  campuses    Campus[]
  rooms       Room[]
  roles       Role[]
  memberships Membership[]
  mfaCredentials UserMfaCredential[]
  backupPolicy TenantBackupPolicy?
  adminBackupDevices AdminBackupDevice[]
  adminBackupDeviceChallenges AdminBackupDeviceChallenge[]
  auditLogs   AuditLog[]
  students    StudentProfile[]
  guardians   GuardianProfile[]
  studentGuardians StudentGuardian[]
  teachers    TeacherProfile[]
  subjects    Subject[]
  grades      Grade[]
  terms       Term[]
  courseProducts CourseProduct[]
  classGroups ClassGroup[]
  classGroupStudents ClassGroupStudent[]
  enrollments Enrollment[]
  courseAccounts CourseAccount[]
  courseConsumptions CourseConsumption[]
  resources   Resource[]
  resourcePermissions ResourcePermission[]
  homeworks   Homework[]
  homeworkSubmissions HomeworkSubmission[]
  homeworkCorrections HomeworkCorrection[]
  learningTasks LearningTask[]
  learningTaskCheckIns LearningTaskCheckIn[]
  knowledgePoints KnowledgePoint[]
  questions   Question[]
  questionKnowledgePoints QuestionKnowledgePoint[]
  errorRecords ErrorRecord[]
  lessons     Lesson[]
  lessonFeedbacks LessonFeedback[]
  schedules   Schedule[]
  scheduleChangeLogs ScheduleChangeLog[]
  attendances Attendance[]
  checkIns    CheckIn[]
  notifications Notification[]
  orders      Order[]
  payments   Payment[]
  refunds    Refund[]
  contractTemplates ContractTemplate[]
  contracts   Contract[]
  teacherCompensationRules TeacherCompensationRule[]
  complianceRules ComplianceRule[]
  activities Activity[]
  activityAssignments ActivityAssignment[]
  activityCheckIns ActivityCheckIn[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model Campus {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  businessHours String?
  status      CampusStatus @default(ACTIVE)
  rooms       Room[]
  memberships Membership[]
  classGroups ClassGroup[]
  schedules   Schedule[]
  activityAssignments ActivityAssignment[] @relation("ActivityAssignmentCampus")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Room {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campusId  String
  campus    Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int?
  equipment String?
  status    RoomStatus @default(ACTIVE)
  schedules Schedule[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, campusId, name])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, status])
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String?      @unique
  phone       String?      @unique
  passwordHash String
  status      UserStatus   @default(ACTIVE)
  failedLoginCount Int      @default(0)
  loginLockLevel Int        @default(0)
  loginLockedUntil DateTime?
  loginPermanentlyLockedAt DateTime?
  lastFailedLoginAt DateTime?
  lastLoginAt DateTime?
  passwordChangedAt DateTime?
  memberships Membership[]
  auditLogs   AuditLog[]   @relation("AuditLogActor")
  scheduleChangeLogs ScheduleChangeLog[] @relation("ScheduleChangeLogActor")
  confirmedCheckIns CheckIn[] @relation("CheckInConfirmedBy")
  assignedHomeworks Homework[] @relation("HomeworkAssignedBy")
  assignedLearningTasks LearningTask[] @relation("LearningTaskAssignedBy")
  receivedNotifications Notification[] @relation("NotificationRecipient")
  requestedRefunds Refund[] @relation("RefundRequestedBy")
  approvedRefunds Refund[] @relation("RefundApprovedBy")
  createdResources Resource[] @relation("ResourceCreatedBy")
  mfaCredentials UserMfaCredential[] @relation("UserMfaCredentialUser")
  adminBackupDevices AdminBackupDevice[] @relation("AdminBackupDeviceAdminUser")
  revokedAdminBackupDevices AdminBackupDevice[] @relation("AdminBackupDeviceRevokedBy")
  adminBackupDeviceChallenges AdminBackupDeviceChallenge[] @relation("AdminBackupDeviceChallengeAdminUser")
  createdActivities Activity[] @relation("ActivityCreatedBy")
  assignedActivities ActivityAssignment[] @relation("ActivityAssignmentAssignedBy")
  submittedActivityCheckIns ActivityCheckIn[] @relation("ActivityCheckInSubmittedBy")
  studentProfiles StudentProfile[]
  guardianProfiles GuardianProfile[]
  teacherProfiles TeacherProfile[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([loginLockedUntil])
  @@index([loginPermanentlyLockedAt])
}

model Role {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         RoleKey
  name        String
  status      RoleStatus   @default(ACTIVE)
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  campusId  String?
  campus    Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, userId, roleId, campusId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([tenantId, status])
}

model UserMfaCredential {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String
  user                User                @relation("UserMfaCredentialUser", fields: [userId], references: [id], onDelete: Cascade)
  provider            String              @default("totp")
  status              MfaCredentialStatus @default(PENDING_VERIFICATION)
  encryptedTotpSecret String
  totpSecretKeyId     String
  backupCodeHash      String?
  failedAttemptCount  Int                 @default(0)
  lastVerifiedAt      DateTime?
  lockedUntil         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([tenantId, userId, provider])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, provider])
}

model TenantBackupPolicy {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled                  Boolean  @default(true)
  maxActiveBackupDevices   Int      @default(1)
  allowStandbyBackupDevice Boolean  @default(false)
  primaryBackupDeviceId    String?
  requireMfaForBackupSync  Boolean  @default(true)
  requireMfaStepUpForExport Boolean @default(true)
  requireMfaStepUpForRestore Boolean @default(true)
  autoSyncOnAdminLogin     Boolean  @default(true)
  minSyncIntervalMinutes   Int      @default(10)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, enabled])
  @@index([tenantId, primaryBackupDeviceId])
}

model AdminBackupDevice {
  id                   String                  @id @default(cuid())
  tenantId             String
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adminUserId          String
  adminUser            User                    @relation("AdminBackupDeviceAdminUser", fields: [adminUserId], references: [id], onDelete: Cascade)
  deviceId             String
  deviceName           String
  publicKey            String
  publicKeyFingerprint String
  deviceRole           AdminBackupDeviceRole   @default(LOGIN_ONLY)
  status               AdminBackupDeviceStatus @default(ACTIVE)
  lastSeenAt           DateTime?
  lastSyncAt           DateTime?
  revokedAt            DateTime?
  revokedById          String?
  revokedBy            User?                   @relation("AdminBackupDeviceRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  replacedByDeviceId   String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([tenantId, deviceId])
  @@index([tenantId])
  @@index([tenantId, adminUserId])
  @@index([tenantId, deviceRole, status])
  @@index([tenantId, publicKeyFingerprint])
  @@index([tenantId, lastSyncAt])
}

model AdminBackupDeviceChallenge {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId    String
  adminUserId String?
  adminUser   User?    @relation("AdminBackupDeviceChallengeAdminUser", fields: [adminUserId], references: [id], onDelete: SetNull)
  nonceHash   String
  purpose     String   @default("core_backup_sync")
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, nonceHash])
  @@index([tenantId, deviceId, expiresAt])
  @@index([tenantId, adminUserId])
  @@index([tenantId, purpose])
  @@index([tenantId, usedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, actorUserId])
  @@index([tenantId, action])
  @@index([tenantId, entityType, entityId])
}

model Notification {
  id              String                @id @default(cuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUserId String?
  recipientUser   User?                 @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientRoleKey RoleKey?
  eventType       NotificationEventType
  status          NotificationStatus    @default(UNREAD)
  title           String
  body            String
  href            String?
  entityType      String?
  entityId        String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, recipientUserId, status])
  @@index([tenantId, recipientRoleKey, status])
  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
}

model StudentProfile {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  gender    StudentGender?
  birthday  DateTime?
  grade     String
  school    String?
  status    StudentStatus  @default(ACTIVE)
  notes     String?
  guardians StudentGuardian[]
  classGroups ClassGroupStudent[]
  enrollments Enrollment[]
  orders      Order[]
  payments    Payment[]
  refunds     Refund[]
  contracts   Contract[]
  courseAccounts CourseAccount[]
  courseConsumptions CourseConsumption[]
  resourcePermissions ResourcePermission[]
  assignedHomeworks Homework[] @relation("HomeworkStudent")
  homeworkSubmissions HomeworkSubmission[]
  errorRecords ErrorRecord[]
  lessonFeedbacks LessonFeedback[]
  assignedLearningTasks LearningTask[] @relation("LearningTaskStudent")
  learningTaskCheckIns LearningTaskCheckIn[]
  activityAssignments ActivityAssignment[] @relation("ActivityAssignmentStudent")
  activityCheckIns ActivityCheckIn[] @relation("ActivityCheckInStudent")
  attendances Attendance[]
  checkIns    CheckIn[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, createdAt])
}

model GuardianProfile {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String?
  email     String?
  status    GuardianStatus @default(ACTIVE)
  students  StudentGuardian[]
  orders    Order[]
  payments  Payment[]
  refunds   Refund[]
  contracts Contract[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, phone])
}

model StudentGuardian {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     GuardianProfile      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([tenantId, studentId, guardianId])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
}

model TeacherProfile {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  phone                 String
  email                 String?
  subjects              String[]
  grades                String[]
  status                TeacherStatus @default(ACTIVE)
  availableTimeNotes    String?
  qualificationFileName String?
  notes                 String?
  primaryClassGroups    ClassGroup[]
  lessons               Lesson[]
  schedules             Schedule[]
  homeworkCorrections   HomeworkCorrection[]
  lessonFeedbacks       LessonFeedback[]
  compensationRules      TeacherCompensationRule[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([tenantId, userId])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

model Subject {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  status    ConfigStatus @default(ACTIVE)
  courseProducts CourseProduct[]
  knowledgePoints KnowledgePoint[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Grade {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0)
  status    ConfigStatus @default(ACTIVE)
  courseProducts CourseProduct[]
  knowledgePoints KnowledgePoint[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, sortOrder])
}

model Term {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  status    ConfigStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, startsAt])
}

model KnowledgePoint {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeId   String
  grade     Grade        @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  chapter   String
  name      String
  code      String?
  sortOrder Int          @default(0)
  parentId  String?
  parent    KnowledgePoint? @relation("KnowledgePointHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgePoint[] @relation("KnowledgePointHierarchy")
  questions QuestionKnowledgePoint[]
  errorRecords ErrorRecord[]
  status    ConfigStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, subjectId, gradeId, chapter, name, parentId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, subjectId, gradeId])
  @@index([tenantId, parentId])
  @@index([tenantId, chapter])
  @@index([tenantId, sortOrder])
}

model Question {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stem           String
  answer         String
  explanation    String?
  difficulty     QuestionDifficulty
  questionType   QuestionType
  status         ConfigStatus         @default(ACTIVE)
  knowledgePoints QuestionKnowledgePoint[]
  errorRecords   ErrorRecord[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, difficulty])
  @@index([tenantId, questionType])
  @@index([tenantId, createdAt])
}

model QuestionKnowledgePoint {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgePointId String
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([tenantId, questionId, knowledgePointId])
  @@index([tenantId])
  @@index([tenantId, questionId])
  @@index([tenantId, knowledgePointId])
}

model ErrorRecord {
  id                   String                @id @default(cuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId            String
