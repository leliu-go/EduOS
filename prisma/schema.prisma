  targetType   ActivityAssignmentTargetType
  campusId     String?
  campus       Campus?                      @relation("ActivityAssignmentCampus", fields: [campusId], references: [id], onDelete: Cascade)
  classGroupId String?
  classGroup   ClassGroup?                  @relation("ActivityAssignmentClassGroup", fields: [classGroupId], references: [id], onDelete: Cascade)
  studentId    String?
  student      StudentProfile?              @relation("ActivityAssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?                        @relation("ActivityAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@unique([tenantId, activityId, targetType, campusId, classGroupId, studentId])
  @@index([tenantId])
  @@index([tenantId, activityId])
  @@index([tenantId, targetType])
  @@index([tenantId, campusId])
  @@index([tenantId, classGroupId])
  @@index([tenantId, studentId])
}

model ActivityCheckIn {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activityId       String
  activity         Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile @relation("ActivityCheckInStudent", fields: [studentId], references: [id], onDelete: Cascade)
  studentUserId    String?
  submittedById    String?
  submittedBy      User?          @relation("ActivityCheckInSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  checkedWordCount Int
  note             String?
  checkInDate      DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, activityId])
  @@index([tenantId, studentId])
  @@index([tenantId, activityId, studentId, checkInDate])
  @@index([tenantId, studentUserId])
  @@index([tenantId, checkInDate])
}

model Homework {
  id               String               @id @default(cuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  instructions     String
  dueAt            DateTime
  status           HomeworkStatus       @default(ASSIGNED)
  assignedByUserId String?
  assignedByUser   User?                @relation("HomeworkAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  classGroupId     String?
  classGroup       ClassGroup?          @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  lessonId         String?
  lesson           Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  studentId        String?
  student          StudentProfile?      @relation("HomeworkStudent", fields: [studentId], references: [id], onDelete: SetNull)
  submissions      HomeworkSubmission[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assignedByUserId])
  @@index([tenantId, classGroupId])
  @@index([tenantId, lessonId])
  @@index([tenantId, studentId])
  @@index([tenantId, dueAt])
}

model HomeworkSubmission {
  id              String                   @id @default(cuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homeworkId      String
  homework        Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber   Int                      @default(1)
  status          HomeworkSubmissionStatus @default(PENDING_CORRECTION)
  contentText     String?
  attachmentsJson Json?
  submittedAt     DateTime                 @default(now())
  corrections     HomeworkCorrection[]
  errorRecords    ErrorRecord[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([tenantId, homeworkId, studentId, attemptNumber])
  @@index([tenantId])
  @@index([tenantId, homeworkId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, submittedAt])
}

model HomeworkCorrection {
  id           String                   @id @default(cuid())
  tenantId     String
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissionId String
  submission   HomeworkSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacherId    String?
  teacher      TeacherProfile?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  status       HomeworkCorrectionStatus
  score        Int?
  comment      String?
  correctedAt  DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([tenantId])
  @@index([tenantId, submissionId])
  @@index([tenantId, teacherId])
  @@index([tenantId, status])
  @@index([tenantId, correctedAt])
}

model LearningTask {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  taskType         LearningTaskType
  targetDate       DateTime
  status           LearningTaskStatus    @default(ACTIVE)
  assignedByUserId String?
  assignedByUser   User?                 @relation("LearningTaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  classGroupId     String?
  classGroup       ClassGroup?           @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  studentId        String?
  student          StudentProfile?       @relation("LearningTaskStudent", fields: [studentId], references: [id], onDelete: SetNull)
  checkIns         LearningTaskCheckIn[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, taskType])
  @@index([tenantId, targetDate])
  @@index([tenantId, classGroupId])
  @@index([tenantId, studentId])
}

model LearningTaskCheckIn {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId      String
  task        LearningTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkedInAt DateTime       @default(now())
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, taskId, studentId])
  @@index([tenantId])
  @@index([tenantId, taskId])
  @@index([tenantId, studentId])
  @@index([tenantId, checkedInAt])
}
