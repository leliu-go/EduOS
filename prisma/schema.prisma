generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CampusStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleKey {
  SUPER_ADMIN
  ORG_ADMIN
  CAMPUS_ADMIN
  ACADEMIC
  FINANCE
  TEACHER
  STUDENT
  PARENT
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  PAUSED
  GRADUATED
  WITHDRAWN
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  RELATIVE
  OTHER
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
}

enum ConfigStatus {
  ACTIVE
  INACTIVE
}

enum CourseType {
  ONE_ON_ONE
  SMALL_GROUP
  LARGE_GROUP
  EVENING_TUTORING
  INTENSIVE
}

enum ClassType {
  OFFLINE
  ONLINE
  HYBRID
}

enum CourseProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ClassGroupStatus {
  PLANNING
  ACTIVE
  PAUSED
  FINISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  WITHDRAWN
}

enum CourseAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  campuses    Campus[]
  rooms       Room[]
  roles       Role[]
  memberships Membership[]
  auditLogs   AuditLog[]
  students    StudentProfile[]
  guardians   GuardianProfile[]
  studentGuardians StudentGuardian[]
  teachers    TeacherProfile[]
  subjects    Subject[]
  grades      Grade[]
  terms       Term[]
  courseProducts CourseProduct[]
  classGroups ClassGroup[]
  classGroupStudents ClassGroupStudent[]
  enrollments Enrollment[]
  courseAccounts CourseAccount[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model Campus {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  businessHours String?
  status      CampusStatus @default(ACTIVE)
  rooms       Room[]
  memberships Membership[]
  classGroups ClassGroup[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Room {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campusId  String
  campus    Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int?
  equipment String?
  status    RoomStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, campusId, name])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, status])
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String?      @unique
  phone       String?      @unique
  passwordHash String
  status      UserStatus   @default(ACTIVE)
  memberships Membership[]
  auditLogs   AuditLog[]   @relation("AuditLogActor")
  studentProfiles StudentProfile[]
  guardianProfiles GuardianProfile[]
  teacherProfiles TeacherProfile[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model Role {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         RoleKey
  name        String
  status      RoleStatus   @default(ACTIVE)
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  campusId  String?
  campus    Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, userId, roleId, campusId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([tenantId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, actorUserId])
  @@index([tenantId, action])
  @@index([tenantId, entityType, entityId])
}

model StudentProfile {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  gender    StudentGender?
  birthday  DateTime?
  grade     String
  school    String?
  status    StudentStatus  @default(ACTIVE)
  notes     String?
  guardians StudentGuardian[]
  classGroups ClassGroupStudent[]
  enrollments Enrollment[]
  courseAccounts CourseAccount[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, createdAt])
}

model GuardianProfile {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String?
  email     String?
  status    GuardianStatus @default(ACTIVE)
  students  StudentGuardian[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, phone])
}

model StudentGuardian {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     GuardianProfile      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([tenantId, studentId, guardianId])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
}

model TeacherProfile {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  phone                 String
  email                 String?
  subjects              String[]
  grades                String[]
  status                TeacherStatus @default(ACTIVE)
  availableTimeNotes    String?
  qualificationFileName String?
  notes                 String?
  primaryClassGroups    ClassGroup[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([tenantId, userId])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

model Subject {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  status    ConfigStatus @default(ACTIVE)
  courseProducts CourseProduct[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Grade {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0)
  status    ConfigStatus @default(ACTIVE)
  courseProducts CourseProduct[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, sortOrder])
}

model Term {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  status    ConfigStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, startsAt])
}

model CourseProduct {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeId     String
  grade       Grade               @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  name        String
  courseType  CourseType
  classType   ClassType
  totalHours  Int
  price       Decimal
  description String?
  status      CourseProductStatus @default(ACTIVE)
  classGroups ClassGroup[]
  enrollments Enrollment[]
  courseAccounts CourseAccount[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, subjectId, gradeId])
}

model ClassGroup {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseProductId  String
  courseProduct    CourseProduct      @relation(fields: [courseProductId], references: [id], onDelete: Restrict)
  primaryTeacherId String
  primaryTeacher   TeacherProfile     @relation(fields: [primaryTeacherId], references: [id], onDelete: Restrict)
  campusId         String
  campus           Campus             @relation(fields: [campusId], references: [id], onDelete: Restrict)
  name             String
  capacity         Int
  status           ClassGroupStatus   @default(PLANNING)
  startsAt         DateTime
  endsAt           DateTime
  students         ClassGroupStudent[]
  enrollments      Enrollment[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, courseProductId])
  @@index([tenantId, primaryTeacherId])
  @@index([tenantId, campusId])
}

model ClassGroupStudent {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenantId, classGroupId, studentId])
  @@index([tenantId, classGroupId])
  @@index([tenantId, studentId])
}

model CourseAccount {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseProductId String
  courseProduct   CourseProduct       @relation(fields: [courseProductId], references: [id], onDelete: Restrict)
  purchasedHours  Int                 @default(0)
  giftHours       Int                 @default(0)
  usedHours       Int                 @default(0)
  frozenHours     Int                 @default(0)
  status          CourseAccountStatus @default(ACTIVE)
  enrollments     Enrollment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([tenantId, studentId, courseProductId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
}

model Enrollment {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseProductId String
  courseProduct   CourseProduct    @relation(fields: [courseProductId], references: [id], onDelete: Restrict)
  classGroupId    String?
  classGroup      ClassGroup?      @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  courseAccountId String
  courseAccount   CourseAccount    @relation(fields: [courseAccountId], references: [id], onDelete: Restrict)
  purchasedHours  Int
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, courseProductId])
  @@index([tenantId, classGroupId])
}
