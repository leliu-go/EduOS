generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CampusStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleKey {
  SUPER_ADMIN
  ORG_ADMIN
  CAMPUS_ADMIN
  ACADEMIC
  FINANCE
  TEACHER
  STUDENT
  PARENT
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  PAUSED
  GRADUATED
  WITHDRAWN
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  RELATIVE
  OTHER
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
}

enum ConfigStatus {
  ACTIVE
  INACTIVE
}

enum CourseType {
  ONE_ON_ONE
  SMALL_GROUP
  LARGE_GROUP
  EVENING_TUTORING
  INTENSIVE
}

enum ClassType {
  OFFLINE
  ONLINE
  HYBRID
}

enum CourseProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ClassGroupStatus {
  PLANNING
  ACTIVE
  PAUSED
  FINISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  WITHDRAWN
}

enum CourseAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LessonStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ScheduleStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
  MAKE_UP
}

enum ScheduleChangeType {
  CREATE
  RESCHEDULE
  CANCEL
  MAKE_UP
}

enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED
  ABSENT
  MAKE_UP
}

enum ResourceType {
  PPT
  HANDOUT
  VIDEO
  AUDIO
  WORKSHEET
  ANSWER
  EXPLANATION
}

enum ResourceStatus {
  ACTIVE
  ARCHIVED
}

enum ResourcePermissionTarget {
  CLASS_GROUP
  STUDENT
  ROLE
}

enum HomeworkStatus {
  DRAFT
  ASSIGNED
  ARCHIVED
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  PENDING_CORRECTION
  CORRECTED
  NEEDS_REVISION
}

enum HomeworkCorrectionStatus {
  CORRECTED
  NEEDS_REVISION
}

enum LearningTaskType {
  READING
  MEMORIZATION
  PRACTICE
  SPECIAL_TRAINING
}

enum LearningTaskStatus {
  ACTIVE
  ARCHIVED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_BLANK
  SHORT_ANSWER
  ESSAY
}

enum ErrorRecordSourceType {
  HOMEWORK_SUBMISSION
  ASSESSMENT_RESULT
  MANUAL
}

enum ErrorReason {
  CONCEPT_UNCLEAR
  CALCULATION_ERROR
  READING_ERROR
  METHOD_ERROR
  CARELESS
  OTHER
}

enum ErrorRecordStatus {
  PENDING_CORRECTION
  CORRECTED
  MASTERED
}

enum NotificationEventType {
  SCHEDULE_CREATED
  SCHEDULE_CHANGED
  ATTENDANCE_CONFIRMED
  COURSE_CONSUMPTION_CREATED
  HOMEWORK_ASSIGNED
  HOMEWORK_CORRECTED
  REPORT_AVAILABLE
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  campuses    Campus[]
  rooms       Room[]
  roles       Role[]
  memberships Membership[]
  auditLogs   AuditLog[]
  students    StudentProfile[]
  guardians   GuardianProfile[]
  studentGuardians StudentGuardian[]
  teachers    TeacherProfile[]
  subjects    Subject[]
  grades      Grade[]
  terms       Term[]
  courseProducts CourseProduct[]
  classGroups ClassGroup[]
  classGroupStudents ClassGroupStudent[]
  enrollments Enrollment[]
  courseAccounts CourseAccount[]
  courseConsumptions CourseConsumption[]
  resources   Resource[]
  resourcePermissions ResourcePermission[]
  homeworks   Homework[]
  homeworkSubmissions HomeworkSubmission[]
  homeworkCorrections HomeworkCorrection[]
  learningTasks LearningTask[]
  learningTaskCheckIns LearningTaskCheckIn[]
  knowledgePoints KnowledgePoint[]
  questions   Question[]
  questionKnowledgePoints QuestionKnowledgePoint[]
  errorRecords ErrorRecord[]
  lessons     Lesson[]
  lessonFeedbacks LessonFeedback[]
  schedules   Schedule[]
  scheduleChangeLogs ScheduleChangeLog[]
  attendances Attendance[]
  checkIns    CheckIn[]
  notifications Notification[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model Campus {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  businessHours String?
  status      CampusStatus @default(ACTIVE)
  rooms       Room[]
  memberships Membership[]
  classGroups ClassGroup[]
  schedules   Schedule[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Room {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campusId  String
  campus    Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int?
  equipment String?
  status    RoomStatus @default(ACTIVE)
  schedules Schedule[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, campusId, name])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, status])
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String?      @unique
  phone       String?      @unique
  passwordHash String
  status      UserStatus   @default(ACTIVE)
  memberships Membership[]
  auditLogs   AuditLog[]   @relation("AuditLogActor")
  scheduleChangeLogs ScheduleChangeLog[] @relation("ScheduleChangeLogActor")
  confirmedCheckIns CheckIn[] @relation("CheckInConfirmedBy")
  assignedHomeworks Homework[] @relation("HomeworkAssignedBy")
  assignedLearningTasks LearningTask[] @relation("LearningTaskAssignedBy")
  receivedNotifications Notification[] @relation("NotificationRecipient")
  studentProfiles StudentProfile[]
  guardianProfiles GuardianProfile[]
  teacherProfiles TeacherProfile[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model Role {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         RoleKey
  name        String
  status      RoleStatus   @default(ACTIVE)
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  campusId  String?
  campus    Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, userId, roleId, campusId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([tenantId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, actorUserId])
  @@index([tenantId, action])
  @@index([tenantId, entityType, entityId])
}

model Notification {
  id              String                @id @default(cuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUserId String?
  recipientUser   User?                 @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientRoleKey RoleKey?
  eventType       NotificationEventType
  status          NotificationStatus    @default(UNREAD)
  title           String
  body            String
  href            String?
  entityType      String?
  entityId        String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, recipientUserId, status])
  @@index([tenantId, recipientRoleKey, status])
  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
}

model StudentProfile {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  gender    StudentGender?
  birthday  DateTime?
  grade     String
  school    String?
  status    StudentStatus  @default(ACTIVE)
  notes     String?
  guardians StudentGuardian[]
  classGroups ClassGroupStudent[]
  enrollments Enrollment[]
  courseAccounts CourseAccount[]
  courseConsumptions CourseConsumption[]
  resourcePermissions ResourcePermission[]
  assignedHomeworks Homework[] @relation("HomeworkStudent")
  homeworkSubmissions HomeworkSubmission[]
  errorRecords ErrorRecord[]
  lessonFeedbacks LessonFeedback[]
  assignedLearningTasks LearningTask[] @relation("LearningTaskStudent")
  learningTaskCheckIns LearningTaskCheckIn[]
  attendances Attendance[]
  checkIns    CheckIn[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, createdAt])
}

model GuardianProfile {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String?
  email     String?
  status    GuardianStatus @default(ACTIVE)
  students  StudentGuardian[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, phone])
}

model StudentGuardian {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     GuardianProfile      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([tenantId, studentId, guardianId])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
}

model TeacherProfile {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  phone                 String
  email                 String?
  subjects              String[]
  grades                String[]
  status                TeacherStatus @default(ACTIVE)
  availableTimeNotes    String?
  qualificationFileName String?
  notes                 String?
  primaryClassGroups    ClassGroup[]
  lessons               Lesson[]
  schedules             Schedule[]
  homeworkCorrections   HomeworkCorrection[]
  lessonFeedbacks       LessonFeedback[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([tenantId, userId])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

model Subject {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  status    ConfigStatus @default(ACTIVE)
  courseProducts CourseProduct[]
  knowledgePoints KnowledgePoint[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Grade {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0)
  status    ConfigStatus @default(ACTIVE)
  courseProducts CourseProduct[]
  knowledgePoints KnowledgePoint[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, sortOrder])
}

model Term {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  status    ConfigStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, startsAt])
}

model KnowledgePoint {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeId   String
  grade     Grade        @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  chapter   String
  name      String
  code      String?
  sortOrder Int          @default(0)
  parentId  String?
  parent    KnowledgePoint? @relation("KnowledgePointHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgePoint[] @relation("KnowledgePointHierarchy")
  questions QuestionKnowledgePoint[]
  errorRecords ErrorRecord[]
  status    ConfigStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, subjectId, gradeId, chapter, name, parentId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, subjectId, gradeId])
  @@index([tenantId, parentId])
  @@index([tenantId, chapter])
  @@index([tenantId, sortOrder])
}

model Question {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stem           String
  answer         String
  explanation    String?
  difficulty     QuestionDifficulty
  questionType   QuestionType
  status         ConfigStatus         @default(ACTIVE)
  knowledgePoints QuestionKnowledgePoint[]
  errorRecords   ErrorRecord[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, difficulty])
  @@index([tenantId, questionType])
  @@index([tenantId, createdAt])
}

model QuestionKnowledgePoint {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgePointId String
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([tenantId, questionId, knowledgePointId])
  @@index([tenantId])
  @@index([tenantId, questionId])
  @@index([tenantId, knowledgePointId])
}

model ErrorRecord {
  id                   String                @id @default(cuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId            String
  student              StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId           String?
  question             Question?             @relation(fields: [questionId], references: [id], onDelete: SetNull)
  homeworkSubmissionId String?
  homeworkSubmission   HomeworkSubmission?   @relation(fields: [homeworkSubmissionId], references: [id], onDelete: SetNull)
  sourceType           ErrorRecordSourceType
  sourceTitle          String?
  knowledgePointId     String
  knowledgePoint       KnowledgePoint        @relation(fields: [knowledgePointId], references: [id], onDelete: Restrict)
  errorReason          ErrorReason
  status               ErrorRecordStatus     @default(PENDING_CORRECTION)
  note                 String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, questionId])
  @@index([tenantId, homeworkSubmissionId])
  @@index([tenantId, knowledgePointId])
  @@index([tenantId, sourceType])
  @@index([tenantId, errorReason])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model CourseProduct {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeId     String
  grade       Grade               @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  name        String
  courseType  CourseType
  classType   ClassType
  totalHours  Int
  price       Decimal
  description String?
  status      CourseProductStatus @default(ACTIVE)
  classGroups ClassGroup[]
  enrollments Enrollment[]
  courseAccounts CourseAccount[]
  courseConsumptions CourseConsumption[]
  resources   Resource[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, subjectId, gradeId])
}

model ClassGroup {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseProductId  String
  courseProduct    CourseProduct      @relation(fields: [courseProductId], references: [id], onDelete: Restrict)
  primaryTeacherId String
  primaryTeacher   TeacherProfile     @relation(fields: [primaryTeacherId], references: [id], onDelete: Restrict)
  campusId         String
  campus           Campus             @relation(fields: [campusId], references: [id], onDelete: Restrict)
  name             String
  capacity         Int
  status           ClassGroupStatus   @default(PLANNING)
  startsAt         DateTime
  endsAt           DateTime
  students         ClassGroupStudent[]
  enrollments      Enrollment[]
  lessons          Lesson[]
  schedules        Schedule[]
  resources        Resource[]
  resourcePermissions ResourcePermission[]
  homeworks        Homework[]
  learningTasks    LearningTask[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, courseProductId])
  @@index([tenantId, primaryTeacherId])
  @@index([tenantId, campusId])
}

model ClassGroupStudent {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenantId, classGroupId, studentId])
  @@index([tenantId, classGroupId])
  @@index([tenantId, studentId])
}

model CourseAccount {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseProductId String
  courseProduct   CourseProduct       @relation(fields: [courseProductId], references: [id], onDelete: Restrict)
  purchasedHours  Int                 @default(0)
  giftHours       Int                 @default(0)
  usedHours       Int                 @default(0)
  frozenHours     Int                 @default(0)
  status          CourseAccountStatus @default(ACTIVE)
  enrollments     Enrollment[]
  courseConsumptions CourseConsumption[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([tenantId, studentId, courseProductId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
}

model Enrollment {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseProductId String
  courseProduct   CourseProduct    @relation(fields: [courseProductId], references: [id], onDelete: Restrict)
  classGroupId    String?
  classGroup      ClassGroup?      @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  courseAccountId String
  courseAccount   CourseAccount    @relation(fields: [courseAccountId], references: [id], onDelete: Restrict)
  purchasedHours  Int
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, courseProductId])
  @@index([tenantId, classGroupId])
}

model Lesson {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup    @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  title        String
  status       LessonStatus  @default(PLANNED)
  schedules    Schedule[]
  resources    Resource[]
  homeworks    Homework[]
  feedbacks    LessonFeedback[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, classGroupId])
  @@index([tenantId, teacherId])
}

model LessonFeedback {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  content     String
  performance String
  mastery     String
  homework    String
  suggestion  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, lessonId, studentId])
  @@index([tenantId])
  @@index([tenantId, lessonId])
  @@index([tenantId, studentId])
  @@index([tenantId, teacherId])
  @@index([tenantId, updatedAt])
}

model Schedule {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classGroupId     String
  classGroup       ClassGroup          @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  campusId         String
  campus           Campus              @relation(fields: [campusId], references: [id], onDelete: Restrict)
  roomId           String
  room             Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  lessonId         String?
  lesson           Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  sourceScheduleId String?
  sourceSchedule   Schedule?           @relation("ScheduleSource", fields: [sourceScheduleId], references: [id], onDelete: SetNull)
  derivedSchedules Schedule[]          @relation("ScheduleSource")
  startAt          DateTime
  endAt            DateTime
  status           ScheduleStatus      @default(SCHEDULED)
  recurrenceRule   String?
  changeLogs       ScheduleChangeLog[]
  attendances      Attendance[]
  checkIns         CheckIn[]
  courseConsumptions CourseConsumption[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tenantId])
  @@index([tenantId, startAt])
  @@index([tenantId, status])
  @@index([tenantId, classGroupId])
  @@index([tenantId, teacherId])
  @@index([tenantId, campusId, roomId])
}

model ScheduleChangeLog {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduleId  String
  schedule    Schedule           @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?              @relation("ScheduleChangeLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  changeType  ScheduleChangeType
  beforeJson  Json?
  afterJson   Json?
  reason      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId, scheduleId])
  @@index([tenantId, changeType])
  @@index([tenantId, createdAt])
}

model Attendance {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     AttendanceStatus
  notes      String?
  courseConsumption CourseConsumption?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([tenantId, scheduleId, studentId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, scheduleId])
  @@index([tenantId, studentId])
}

model CheckIn {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduleId        String
  schedule          Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkedInAt       DateTime       @default(now())
  confirmedAt       DateTime?
  confirmedByUserId String?
  confirmedByUser   User?          @relation("CheckInConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([tenantId, scheduleId, studentId])
  @@index([tenantId])
  @@index([tenantId, scheduleId])
  @@index([tenantId, studentId])
  @@index([tenantId, confirmedAt])
}

model CourseConsumption {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduleId      String
  schedule        Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  attendanceId    String?        @unique
  attendance      Attendance?    @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseProductId String
  courseProduct   CourseProduct  @relation(fields: [courseProductId], references: [id], onDelete: Restrict)
  courseAccountId String
  courseAccount   CourseAccount  @relation(fields: [courseAccountId], references: [id], onDelete: Restrict)
  consumedHours   Int
  reason          String?
  reversedAt      DateTime?
  reversedByUserId String?
  reversalReason  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, scheduleId, studentId])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, courseAccountId])
  @@index([tenantId, courseProductId])
  @@index([tenantId, createdAt])
  @@index([tenantId, reversedAt])
}

model Resource {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  resourceType    ResourceType
  status          ResourceStatus       @default(ACTIVE)
  fileName        String?
  fileUrl         String?
  mimeType        String?
  fileSize        Int?
  releaseAt       DateTime?
  courseProductId String?
  courseProduct   CourseProduct?       @relation(fields: [courseProductId], references: [id], onDelete: SetNull)
  classGroupId    String?
  classGroup      ClassGroup?          @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  lessonId        String?
  lesson          Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  permissions     ResourcePermission[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, resourceType])
  @@index([tenantId, courseProductId])
  @@index([tenantId, classGroupId])
  @@index([tenantId, lessonId])
  @@index([tenantId, releaseAt])
  @@index([tenantId, createdAt])
}

model ResourcePermission {
  id           String                   @id @default(cuid())
  tenantId     String
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     Resource                 @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  target       ResourcePermissionTarget
  classGroupId String?
  classGroup   ClassGroup?              @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  studentId    String?
  student      StudentProfile?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roleKey      RoleKey?
  canView      Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([tenantId, resourceId])
  @@index([tenantId, target])
  @@index([tenantId, classGroupId])
  @@index([tenantId, studentId])
  @@index([tenantId, roleKey])
}

model Homework {
  id               String               @id @default(cuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  instructions     String
  dueAt            DateTime
  status           HomeworkStatus       @default(ASSIGNED)
  assignedByUserId String?
  assignedByUser   User?                @relation("HomeworkAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  classGroupId     String?
  classGroup       ClassGroup?          @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  lessonId         String?
  lesson           Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  studentId        String?
  student          StudentProfile?      @relation("HomeworkStudent", fields: [studentId], references: [id], onDelete: SetNull)
  submissions      HomeworkSubmission[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assignedByUserId])
  @@index([tenantId, classGroupId])
  @@index([tenantId, lessonId])
  @@index([tenantId, studentId])
  @@index([tenantId, dueAt])
}

model HomeworkSubmission {
  id              String                   @id @default(cuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homeworkId      String
  homework        Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber   Int                      @default(1)
  status          HomeworkSubmissionStatus @default(PENDING_CORRECTION)
  contentText     String?
  attachmentsJson Json?
  submittedAt     DateTime                 @default(now())
  corrections     HomeworkCorrection[]
  errorRecords    ErrorRecord[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([tenantId, homeworkId, studentId, attemptNumber])
  @@index([tenantId])
  @@index([tenantId, homeworkId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, submittedAt])
}

model HomeworkCorrection {
  id           String                   @id @default(cuid())
  tenantId     String
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissionId String
  submission   HomeworkSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacherId    String?
  teacher      TeacherProfile?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  status       HomeworkCorrectionStatus
  score        Int?
  comment      String?
  correctedAt  DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([tenantId])
  @@index([tenantId, submissionId])
  @@index([tenantId, teacherId])
  @@index([tenantId, status])
  @@index([tenantId, correctedAt])
}

model LearningTask {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  taskType         LearningTaskType
  targetDate       DateTime
  status           LearningTaskStatus    @default(ACTIVE)
  assignedByUserId String?
  assignedByUser   User?                 @relation("LearningTaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  classGroupId     String?
  classGroup       ClassGroup?           @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  studentId        String?
  student          StudentProfile?       @relation("LearningTaskStudent", fields: [studentId], references: [id], onDelete: SetNull)
  checkIns         LearningTaskCheckIn[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, taskType])
  @@index([tenantId, targetDate])
  @@index([tenantId, classGroupId])
  @@index([tenantId, studentId])
}

model LearningTaskCheckIn {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId      String
  task        LearningTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkedInAt DateTime       @default(now())
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, taskId, studentId])
  @@index([tenantId])
  @@index([tenantId, taskId])
  @@index([tenantId, studentId])
  @@index([tenantId, checkedInAt])
}
