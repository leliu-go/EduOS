# EduOS production environment template.
# Copy to .env.production.local on the deployment host and fill real values there.
# Never commit .env.production.local or real secrets.

NODE_ENV=production

# Database
DATABASE_URL=

# Resource storage
RESOURCE_STORAGE_PROVIDER=aliyun-oss
RESOURCE_STORAGE_LOCAL_ROOT=.local/resource-storage
RESOURCE_STORAGE_LOCAL_BUCKET=local-resource-storage

# Aliyun OSS private bucket
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION=
ALIYUN_OSS_SIGNED_URL_TTL_SECONDS=300

# MFA placeholders. Real encryption material must be provisioned outside source control.
MFA_TOTP_ISSUER=EduOS
MFA_SECRET_ENCRYPTION_KEY=
MFA_BACKUP_CODE_PEPPER=
